        {
          "name": "Crear categoria (correcta)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "  {\n    \"nom\": \"Categoria Postman\",\n    \"slug\": \"{{slugCategoria}}\",\n    \"descripcio\": \"Categoria creada amb Postman\",\n    \"actiu\": true\n  }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"slugCategoria\", \"cat-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response is JSON\", () => {",
                  "  pm.response.to.be.json;",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set(\"categoriaId\", pm.response.json().data._id);",
                  "}"
                ]
              }
            }
          ]
        },
